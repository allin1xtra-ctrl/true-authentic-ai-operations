DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_ENCRYPTION_KEY=
APP_BASE_URL=

# VERCEL_OIDC_TOKEN may be injected automatically by a supported runtime.
# Never create NEXT_PUBLIC_ variants of private credentials.

# Non-secret Shopify proxy origin. OAuth credentials and tokens remain in Vercel.
SHOPIFY_BACKEND_URL=https://true-authentic-ai-team-backend.vercel.app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=https://true-authentic-ai-team-backend.vercel.app/api/shopify/oauth/callback
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_fulfillments
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
