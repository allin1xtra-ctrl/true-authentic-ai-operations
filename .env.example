# Server-only AI credentials. Configure one provider in the hosted environment.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AUTOMATION_CRON_SECRET=

# VERCEL_OIDC_TOKEN may be injected automatically by a supported runtime.
# Never create NEXT_PUBLIC_ variants of private credentials.

# Non-secret Shopify proxy origin. OAuth credentials and tokens remain in Vercel.
SHOPIFY_BACKEND_URL=https://true-authentic-ai-team-backend.vercel.app
GMAIL_ACCESS_TOKEN=
METRICOOL_API_TOKEN=
METRICOOL_USER_TOKEN=

# Never use a NEXT_PUBLIC_ variant for any integration credential.
