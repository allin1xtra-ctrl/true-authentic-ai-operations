# Server-only AI credentials. Configure one provider in the hosted environment.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# VERCEL_OIDC_TOKEN may be injected automatically by a supported runtime.
# Never create NEXT_PUBLIC_ variants of private credentials.

# Optional server-only read-only integration health checks. External mutations
# remain disabled even when these checks pass.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=
METRICOOL_API_TOKEN=
METRICOOL_USER_TOKEN=

# External action adapters are intentionally not implemented or enabled yet.
# Shopify, Gmail, and Metricool must remain Connection required until a
# server-side adapter performs a successful live validation.
